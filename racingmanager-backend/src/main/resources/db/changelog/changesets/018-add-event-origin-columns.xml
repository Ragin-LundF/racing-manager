<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="add-event-origin-columns" author="ragin">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="events" columnName="origin_tenant_id"/></not>
        </preConditions>
        <addColumn tableName="events">
            <column name="origin_tenant_id" type="BINARY(16)"/>
            <column name="origin_package_id" type="BINARY(16)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
