<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-knockout-matches-table" author="ragin">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="knockout_matches"/></not>
        </preConditions>
        <createTable tableName="knockout_matches">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tournament_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_knockout_matches_tournament" references="knockout_tournaments(id)"/>
            </column>
            <column name="round_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="match_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="participant1_id" type="UUID"/>
            <column name="participant2_id" type="UUID"/>
            <column name="winner_id" type="UUID"/>
            <column name="heat_id" type="UUID"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
