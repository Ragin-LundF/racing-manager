<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="add-event-sync-columns" author="ragin">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="events" columnName="locked_for_sync"/></not>
        </preConditions>
        <addColumn tableName="events">
            <column name="locked_for_sync" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="sync_status" type="VARCHAR(50)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
