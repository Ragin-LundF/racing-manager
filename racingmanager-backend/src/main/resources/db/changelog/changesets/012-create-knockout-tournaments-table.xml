<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-knockout-tournaments-table" author="ragin">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="knockout_tournaments"/></not>
        </preConditions>
        <createTable tableName="knockout_tournaments">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_knockout_tournaments_event" references="events(id)"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="pairing_mode" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="qualification_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_knockout_tournaments_qualification" references="qualifications(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="finalized_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="finalized_by" type="UUID"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
