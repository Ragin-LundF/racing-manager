<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-measurements-table" author="ragin">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="measurements"/></not>
        </preConditions>
        <createTable tableName="measurements">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="heat_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_measurements_heat" references="heats(id)"/>
            </column>
            <column name="lane" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="duration_nanos" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="outcome" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="received_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
