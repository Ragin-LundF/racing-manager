<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-spectator-exchange-codes-table" author="ragin">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="spectator_exchange_codes"/></not>
        </preConditions>
        <createTable tableName="spectator_exchange_codes">
            <column name="id" type="BINARY(16)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="BINARY(16)">
                <constraints nullable="false" foreignKeyName="fk_spectator_exchange_codes_tenant" references="tenants(id)"/>
            </column>
            <column name="event_id" type="BINARY(16)">
                <constraints nullable="false" foreignKeyName="fk_spectator_exchange_codes_event" references="events(id)"/>
            </column>
            <column name="token" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="consumed" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
