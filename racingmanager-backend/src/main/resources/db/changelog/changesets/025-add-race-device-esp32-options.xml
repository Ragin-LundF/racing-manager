<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="add-race-device-esp32-options" author="ragin">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="race_device_settings" columnName="esp32_options"/></not>
        </preConditions>
        <!-- JSON blob of Esp32WebSocketDirectSettings; null for the other modes. -->
        <addColumn tableName="race_device_settings">
            <column name="esp32_options" type="TEXT"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
