<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-initial-tables" author="racingmanager">
        <createTable tableName="users">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="password_hash" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <createTable tableName="sessions">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_sessions_user" references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="last_accessed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="audit_entries">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="actor_id" type="UUID"/>
            <column name="action" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="target_type" type="VARCHAR(100)"/>
            <column name="target_id" type="UUID"/>
            <column name="summary" type="TEXT"/>
            <column name="details" type="TEXT"/>
            <column name="correlation_id" type="VARCHAR(255)"/>
            <column name="occurred_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="create-event-tables" author="racingmanager">
        <createTable tableName="events">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="lane_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="measurement_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="max_participants" type="INT"/>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_events_created_by" references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="activated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

    <changeSet id="create-participant-tables" author="racingmanager">
        <createTable tableName="participants">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_participants_event" references="events(id)"/>
            </column>
            <column name="start_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="club" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <createIndex tableName="participants" indexName="idx_participants_event_start_number" unique="true">
            <column name="event_id"/>
            <column name="start_number"/>
        </createIndex>

        <createTable tableName="vehicles">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="participant_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_vehicles_participant" references="participants(id)" deleteCascade="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="event_seeds">
            <column name="event_id" type="UUID">
                <constraints primaryKey="true" foreignKeyName="fk_event_seeds_event" references="events(id)"/>
            </column>
            <column name="seed" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="randomized_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="randomized_by" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_event_seeds_user" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="create-qualification-table" author="racingmanager">
        <createTable tableName="qualifications">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_qualifications_event" references="events(id)"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="number_of_runs" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="seed" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="finalized_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="finalized_by" type="UUID"/>
        </createTable>
    </changeSet>

    <changeSet id="create-heat-tables" author="racingmanager">
        <createTable tableName="heats">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_heats_event" references="events(id)"/>
            </column>
            <column name="round" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="heat_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="armed_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="started_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="finished_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <createTable tableName="heat_lanes">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="heat_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_heat_lanes_heat" references="heats(id)"/>
            </column>
            <column name="lane" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="participant_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_heat_lanes_participant" references="participants(id)"/>
            </column>
            <column name="participant_start_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="participant_first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="participant_last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="measurements">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="heat_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_measurements_heat" references="heats(id)"/>
            </column>
            <column name="lane" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="duration_nanos" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="outcome" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="received_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
